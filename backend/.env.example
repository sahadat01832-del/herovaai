# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/contentbot

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Admin Credentials (first-time seed) — set a strong password here; there is no
# hardcoded fallback. Rotate it in Settings after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Twilio (for OTP - optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ContentBot API Key (your existing service)
CONTENTBOT_API_KEY=your_contentbot_api_key
CONTENTBOT_API_URL=http://localhost:8000

# Session Secret
SESSION_SECRET=your_session_secret_change_this

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Payments (SSLCommerz — cards, bKash, Nagad, Rocket)
# Sandbox (free test mode) is default: leave these empty to use the demo store.
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
PAYMENT_PRO_USD=19
PAYMENT_ENTERPRISE_USD=49
