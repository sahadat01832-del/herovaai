[Unit]
Description=HerovaAi Gateway (one public origin: frontend + /api + /socket.io)
After=network.target contentbot-backend.service contentbot-frontend.service
Wants=contentbot-backend.service contentbot-frontend.service

[Service]
Type=simple
WorkingDirectory=/home/sahadat/herovaai
ExecStart=/home/sahadat/.nvm/versions/node/v26.8.2/bin/node /home/sahadat/herovaai/scripts/gateway.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=GATEWAY_PORT=8088
Environment=WEB_PORT=3003
Environment=API_PORT=5000
Environment=STUDIO_PORT=3002
Environment=GATEWAY_EXTRA_PORTS=3001
StandardOutput=append:/home/sahadat/herovaai/logs/gateway.log
StandardError=append:/home/sahadat/herovaai/logs/gateway.log

[Install]
WantedBy=default.target
